# SampIntel AI local configuration. Copy to .env and replace every value marked CHANGE-ME.
# Never commit .env. In production these come from the secret manager.

NODE_ENV=development
PORT=4100

# API connects as a login role that is a member of si_app (row-level security applies to it).
DATABASE_URL=postgres://si_api:CHANGE-ME@localhost:5432/sampintel
# Owner role: migrations and the tenant provisioning CLI only.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE-ME@localhost:5432/sampintel

# 32+ random characters:  openssl rand -hex 32
SESSION_SECRET=CHANGE-ME
# 32 random bytes, base64:  openssl rand -base64 32
FIELD_ENCRYPTION_KEY=CHANGE-ME

WEB_ORIGIN=http://localhost:3100
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT=10
# Requests per minute per client address on every other route.
API_RATE_LIMIT=300
COOKIE_SECURE=false

# Web app: where Next.js forwards /api/v1 (server side only).
SI_API_URL=http://localhost:4100

# Only for `pnpm db:seed:demo` (local DEMO tenant) and `tenant:create`.
SI_DEMO_PASSWORD=CHANGE-ME
SI_ADMIN_PASSWORD=CHANGE-ME

# Docker Compose only
POSTGRES_PASSWORD=CHANGE-ME
SI_API_DB_PASSWORD=CHANGE-ME

# Seconds between synthetic QA worker passes (0 turns the in-process worker off).
QA_TICK_SECONDS=15
